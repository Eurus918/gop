# ============================================================
# 随行 GoP · 环境变量样例
# 用法：cp .env.example .env 然后填入你自己的 Key
# 注意：.env 已在 .gitignore 中，不会被提交。
#       什么都不填也能跑 —— 会自动使用内置的 mock 数据（真实采集快照）。
# ============================================================

# 服务端口
PORT=3000

# ------------------------------------------------------------
# 高德开放平台（推荐配置，免费额度足够个人使用）
# 申请：https://console.amap.com/dev/key/app
# 用途：地理编码、公交/驾车路径规划、POI 搜索、天气
#       —— 路径规划直接决定「高铁站到酒店多久」「景点之间多久」，是分钟级排程的真实数据来源
# ------------------------------------------------------------
AMAP_KEY=

# ------------------------------------------------------------
# 大模型（AI 小助手）
# 兼容 OpenAI Chat Completions 协议，DeepSeek / 通义 / Kimi / Moonshot / OpenAI 均可
# 不填则降级为本地规则引擎（内置高频问答库，不会编造答案）
# ------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------
# 车次数据 —— 默认已经是真实实时的，不需要配置
#
# 默认 12306：直接调 12306 官方网页的公开查询接口，拿到真实余票与真实票价，
#             支持任意站点对（内置全量站点码表，首次自动下载缓存）。
#             内置限速（最小请求间隔 1.2s）与结果缓存，请勿用于高频/商业调用。
#             商用请走 12306 官方或 OTA 开放平台的正式授权渠道。
#
# 可选值：
#   12306     —— 默认，实时余票 + 实时票价
#   snapshot  —— 完全不联网，只用内置真实采集快照
#   custom    —— 你自己实现的接口（配合下面的 TRAIN_API_BASE）
# ------------------------------------------------------------
TRAIN_PROVIDER=12306
TRAIN_API_BASE=
TRAIN_API_KEY=

# ------------------------------------------------------------
# 酒店数据（可选）
# 携程 / 美团 / 飞猪开放平台或联盟计划拿到后可填这里
# ------------------------------------------------------------
HOTEL_API_BASE=
HOTEL_API_KEY=
